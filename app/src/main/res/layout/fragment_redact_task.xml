<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/exit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/arrow_left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/offset_xl"
        android:layout_marginStart="@dimen/offset_l"/>

    <TextView
        android:id="@+id/date_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        tools:layout_editor_absoluteX="121dp"
        tools:layout_editor_absoluteY="41dp"
        app:layout_constraintStart_toEndOf="@id/exit"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/offset_xl"
        android:layout_marginStart="@dimen/offset_l"
        tools:ignore="HardcodedText" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="179dp"
        app:layout_constraintTop_toBottomOf="@id/date_title"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/offset_l"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="@dimen/offset_l"
        android:layout_marginEnd="@dimen/offset_l"
        android:id="@+id/red_task">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/offset_m">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/title_text_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:ignore="SpeakableTextPresentCheck" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/description_text_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title_text_layout"
            android:layout_marginTop="@dimen/offset_l">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/description_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:ignore="SpeakableTextPresentCheck" />

        </com.google.android.material.textfield.TextInputLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="215dp"
        app:layout_constraintTop_toBottomOf="@id/red_task"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/offset_xxl"
        android:id="@+id/task_options"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="@dimen/offset_l"
        android:layout_marginEnd="@dimen/offset_l"/>

    <androidx.recyclerview.widget.RecyclerView
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="126dp"
        app:layout_constraintTop_toBottomOf="@id/task_options"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="@dimen/offset_l"
        android:layout_marginEnd="@dimen/offset_l"
        android:orientation="horizontal"
        android:id="@+id/priority"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/delete_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/date_bottom"
        tools:layout_editor_absoluteX="78dp"
        tools:layout_editor_absoluteY="542dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="@dimen/offset_l"
        android:layout_marginBottom="@dimen/offset_l"
        app:icon="@drawable/ic_delete"
        android:backgroundTint="@color/basic_color"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/save_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/save_bottom"
        tools:layout_editor_absoluteX="263dp"
        tools:layout_editor_absoluteY="546dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="@dimen/offset_l"
        android:layout_marginBottom="@dimen/offset_l"
        app:icon="@drawable/save_24px"
        android:backgroundTint="@color/purple"/>


</androidx.constraintlayout.widget.ConstraintLayout>